<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gallery — Bonsai Building</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Source+Sans+3:wght@300;400;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --forest:  #1C2B1A;
      --moss:    #4A6741;
      --cedar:   #C8A96E;
      --birch:   #F7F3EC;
      --bark:    #2E2218;
      --bark-lt: #5C4033;
    }
    html { scroll-behavior: smooth; }
    body { font-family: 'Source Sans 3', sans-serif; background: var(--birch); color: var(--bark); }
    nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; padding: 1rem 2.5rem; background: rgba(28,43,26,0.97); }
    .nav-logo { font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 700; color: var(--birch); }
    .nav-logo span { color: var(--cedar); }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a { color: rgba(247,243,236,0.75); text-decoration: none; font-size: 0.83rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; }
    .nav-links a:hover { color: var(--cedar); }
    .page { padding: 7rem 2.5rem 4rem; max-width: 1400px; margin: 0 auto; }
    h1 { font-family: 'Playfair Display', serif; font-size: clamp(2.2rem, 5vw, 3.5rem); margin-bottom: 0.5rem; }
    .subtitle { color: var(--bark-lt); margin-bottom: 2.5rem; font-size: 1.05rem; }
    .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1rem; }
    .gallery img { width: 100%; height: 280px; object-fit: cover; display: block; }
    .caption { font-size: 0.85rem; color: var(--bark-lt); margin-top: 0.4rem; margin-bottom: 1.2rem; }
    footer { background: var(--forest); color: rgba(247,243,236,0.6); text-align: center; padding: 2rem; margin-top: 3rem; }
    .footer-logo { font-family: 'Playfair Display', serif; font-size: 1.2rem; color: var(--birch); }
    .footer-logo span { color: var(--cedar); }
    @media (max-width: 700px) {
      .page { padding: 6rem 1.2rem 3rem; }
      .gallery { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
<nav>
  <div class="nav-logo">Bonsai <span>Building</span></div>
  <ul class="nav-links">
    <li><a href="index.html">Home</a></li>
    <li><a href="index.html#about">About</a></li>
    <li><a href="index.html#products">Structures</a></li>
    <li><a href="gallery.html">Gallery</a></li>
    <li><a href="index.html#contact">Get a Quote</a></li>
  </ul>
</nav>
<div class="page">
  <h1>Gallery</h1>
  <p class="subtitle">Sheds, lean-tos, and small outdoor structures for animal protection, storage, and equipment — all under 200 square feet. Serving the Willamette Valley and Northwest Oregon.</p>
  <div class="gallery">
    <div><img src="data:image/jpeg;base64," alt="Green open lean-to in field" /><div class="caption">Open lean-to shelter</div></div>
    <div><img src="data:image/jpeg;base64," alt="Green lean-to in grassy field" /><div class="caption">Field lean-to with wood framing</div></div>
    <div><img src="data:image/jpeg;base64," alt="Red metal lean-to" /><div class="caption">Red metal lean-to / storage</div></div>
    <div><img src="data:image/jpeg;base64," alt="Green gable shed" /><div class="caption">Green gable storage shed</div></div>
    <div><img src="data:image/jpeg;base64," alt="Beige wooden shed" /><div class="caption">Beige wooden shed</div></div>
    <div><img src="data:image/jpeg;base64," alt="Blue storage shed" /><div class="caption">Blue storage shed</div></div>
  </div>
</div>
<footer>
  <div class="footer-logo">Bonsai <span>Building</span></div>
  <p>© 2026 Bonsai Building · Willamette Valley & Northwest Oregon</p>
</footer>
</body>
</html>
